# PiSight environment file
#
# Install to /etc/pisight/pisight.env with root-only permissions:
#
#     sudo install -o root -g root -m 0600 config/pisight.env.example /etc/pisight/pisight.env
#     sudo nano /etc/pisight/pisight.env
#
# The systemd unit reads this file as root and passes it to the unprivileged pisight user's
# process environment. Mode 0600 keeps the token out of reach of every other account on
# the Pi, and out of `ps` output for other users.
#
# NEVER commit a real token. NEVER put the token in config.toml, which is world-readable.

# Read-only Kismet API token.
#
# Generate one in the Kismet web UI while logged in as the admin user:
#   1. open http://127.0.0.1:2501 in a browser on the Pi
#   2. log in with your Kismet administrator account
#   3. open the menu (top right) and choose "API Tokens"
#   4. create a token with:
#        Name: pisight
#        Role: readonly
#        User: your Kismet user
#   5. copy the generated token and paste it below
#
# The `readonly` role grants access only to endpoints that do not modify devices, state or
# configuration. PiSight needs nothing more. Do not use an `admin` token, and never put the
# Kismet administrator password anywhere in this file.
PISIGHT_KISMET_API_TOKEN=replace_with_your_readonly_token

# --- Optional overrides -------------------------------------------------------------
# Anything set here wins over /etc/pisight/config.toml.

# Data source: mock or live.
PISIGHT_MODE=live

# SDL video driver. Deployment profile A (direct DRM/KMS console) uses kmsdrm;
# profile B (inside a desktop session) usually needs nothing set at all.
# See docs/RPI5_DEPLOYMENT.md for which profile applies to your setup.
#SDL_VIDEODRIVER=kmsdrm

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL.
#PISIGHT_LOG_LEVEL=INFO

# Alternate configuration file.
#PISIGHT_CONFIG=/etc/pisight/config.toml

# Where Kismet writes logs, used only to display free space.
#PISIGHT_STORAGE_PATH=/var/log/kismet
