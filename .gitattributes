# Normalise line endings in the repository to LF.
* text=auto eol=lf

# These MUST be LF on disk wherever they run. A CRLF shebang line makes bash fail with
# "bad interpreter: /usr/bin/env bash^M", and systemd rejects a unit with CR characters.
*.sh text eol=lf
*.service text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary: never touch these.
*.png binary
